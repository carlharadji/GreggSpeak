# Example variable names only. Replace placeholders privately; do not use them as credentials.
# The applications do not automatically load this file.
GREGGSPEAK_WEB_USERNAME=admin
GREGGSPEAK_WEB_PASSWORD=REPLACE_WITH_A_UNIQUE_PRIVATE_PASSWORD
GREGGSPEAK_SECRET_KEY=REPLACE_WITH_A_RANDOM_PRIVATE_SESSION_KEY
# Optional for unattended Raspberry Pi hotspot setup; interactive setup prompts.
GREGGSPEAK_HOTSPOT_PASSWORD=REPLACE_WITH_A_UNIQUE_PRIVATE_WIFI_PASSWORD
